{
  "meta": {
    "voice": "zh-CN-YunjianNeural",
    "rate": "-2%",
    "sample_rate": 24000,
    "lead_in_sec": 0.3,
    "pause_sec": 0.6,
    "tail_sec": 2.0,
    "total_duration_sec": 251.937,
    "target_lufs": -14.0,
    "measured_lufs": -14.96,
    "segments_count": 78,
    "generated_at": "2026-10-30 16:12:42"
  },
  "timeline": [
    {
      "index": 1,
      "id": "L1",
      "text": "豫章故郡，洪都新府。",
      "start_time": 0.3,
      "end_time": 2.55,
      "duration": 2.25
    },
    {
      "index": 2,
      "id": "L2",
      "text": "星分翼轸，地接衡庐。",
      "start_time": 3.15,
      "end_time": 5.372,
      "duration": 2.221
    },
    {
      "index": 3,
      "id": "L3",
      "text": "襟三江而带五湖，控蛮荆而引瓯越。",
      "start_time": 5.972,
      "end_time": 9.487,
      "duration": 3.516
    },
    {
      "index": 4,
      "id": "L4",
      "text": "物华天宝，龙光射牛斗之墟；",
      "start_time": 10.087,
      "end_time": 13.095,
      "duration": 3.008
    },
    {
      "index": 5,
      "id": "L5",
      "text": "人杰地灵，徐孺下陈蕃之榻。",
      "start_time": 13.695,
      "end_time": 16.606,
      "duration": 2.911
    },
    {
      "index": 6,
      "id": "L6",
      "text": "雄州雾列，俊采星驰。",
      "start_time": 17.206,
      "end_time": 19.561,
      "duration": 2.355
    },
    {
      "index": 7,
      "id": "L7",
      "text": "台隍枕夷夏之交，宾主尽东南之美。",
      "start_time": 20.161,
      "end_time": 23.497,
      "duration": 3.336
    },
    {
      "index": 8,
      "id": "L8",
      "text": "都督阎公之雅望，棨戟遥临；",
      "start_time": 24.097,
      "end_time": 26.825,
      "duration": 2.728
    },
    {
      "index": 9,
      "id": "L9",
      "text": "宇文新州之懿范，襜帷暂驻。",
      "start_time": 27.425,
      "end_time": 30.28,
      "duration": 2.854
    },
    {
      "index": 10,
      "id": "L10",
      "text": "十旬休假，胜友如云；",
      "start_time": 30.88,
      "end_time": 33.41,
      "duration": 2.531
    },
    {
      "index": 11,
      "id": "L11",
      "text": "千里逢迎，高朋满座。",
      "start_time": 34.011,
      "end_time": 36.26,
      "duration": 2.249
    },
    {
      "index": 12,
      "id": "L12",
      "text": "腾蛟起凤，孟学士之词宗；",
      "start_time": 36.86,
      "end_time": 39.789,
      "duration": 2.929
    },
    {
      "index": 13,
      "id": "L13",
      "text": "紫电青霜，王将军之武库。",
      "start_time": 40.389,
      "end_time": 43.132,
      "duration": 2.744
    },
    {
      "index": 14,
      "id": "L14",
      "text": "家君作宰，路出名区；",
      "start_time": 43.732,
      "end_time": 45.999,
      "duration": 2.267
    },
    {
      "index": 15,
      "id": "L15",
      "text": "童子何知，躬逢胜饯。",
      "start_time": 46.599,
      "end_time": 48.741,
      "duration": 2.142
    },
    {
      "index": 16,
      "id": "L16",
      "text": "时维九月，序属三秋。",
      "start_time": 49.341,
      "end_time": 51.535,
      "duration": 2.194
    },
    {
      "index": 17,
      "id": "L17",
      "text": "潦水尽而寒潭清，烟光凝而暮山紫。",
      "start_time": 52.135,
      "end_time": 55.653,
      "duration": 3.518
    },
    {
      "index": 18,
      "id": "L18",
      "text": "俨骖騑于上路，访风景于崇阿；",
      "start_time": 56.253,
      "end_time": 59.149,
      "duration": 2.896
    },
    {
      "index": 19,
      "id": "L19",
      "text": "临帝子之长洲，得天人之旧馆。",
      "start_time": 59.749,
      "end_time": 62.778,
      "duration": 3.03
    },
    {
      "index": 20,
      "id": "L20",
      "text": "层峦耸翠，上出重霄；",
      "start_time": 63.378,
      "end_time": 65.645,
      "duration": 2.267
    },
    {
      "index": 21,
      "id": "L21",
      "text": "飞阁流丹，下临无地。",
      "start_time": 66.245,
      "end_time": 68.45,
      "duration": 2.205
    },
    {
      "index": 22,
      "id": "L22",
      "text": "鹤汀凫渚，穷岛屿之萦回；",
      "start_time": 69.05,
      "end_time": 71.774,
      "duration": 2.724
    },
    {
      "index": 23,
      "id": "L23",
      "text": "桂殿兰宫，即冈峦之体势。",
      "start_time": 72.374,
      "end_time": 74.851,
      "duration": 2.477
    },
    {
      "index": 24,
      "id": "L24",
      "text": "披绣闼，俯雕甍，山原旷其盈视，川泽纡其骇瞩。",
      "start_time": 75.451,
      "end_time": 80.325,
      "duration": 4.873
    },
    {
      "index": 25,
      "id": "L25",
      "text": "闾阎扑地，钟鸣鼎食之家；",
      "start_time": 80.924,
      "end_time": 83.526,
      "duration": 2.602
    },
    {
      "index": 26,
      "id": "L26",
      "text": "舸舰弥津，青雀黄龙之舳。",
      "start_time": 84.126,
      "end_time": 86.757,
      "duration": 2.631
    },
    {
      "index": 27,
      "id": "L27",
      "text": "云销雨霁，彩彻区明。",
      "start_time": 87.358,
      "end_time": 89.576,
      "duration": 2.218
    },
    {
      "index": 28,
      "id": "L28",
      "text": "落霞与孤鹜齐飞，秋水共长天一色。",
      "start_time": 90.176,
      "end_time": 93.294,
      "duration": 3.118
    },
    {
      "index": 29,
      "id": "L29",
      "text": "渔舟唱晚，响穷彭蠡之滨；",
      "start_time": 93.894,
      "end_time": 96.751,
      "duration": 2.857
    },
    {
      "index": 30,
      "id": "L30",
      "text": "雁阵惊寒，声断衡阳之浦。",
      "start_time": 97.351,
      "end_time": 100.046,
      "duration": 2.695
    },
    {
      "index": 31,
      "id": "L31",
      "text": "遥襟甫畅，逸兴遄飞。",
      "start_time": 100.646,
      "end_time": 102.718,
      "duration": 2.072
    },
    {
      "index": 32,
      "id": "L32",
      "text": "爽籁发而清风生，纤歌凝而白云遏。",
      "start_time": 103.318,
      "end_time": 106.902,
      "duration": 3.584
    },
    {
      "index": 33,
      "id": "L33",
      "text": "睢园绿竹，气凌彭泽之樽；",
      "start_time": 107.502,
      "end_time": 110.21,
      "duration": 2.708
    },
    {
      "index": 34,
      "id": "L34",
      "text": "邺水朱华，光照临川之笔。",
      "start_time": 110.81,
      "end_time": 113.527,
      "duration": 2.717
    },
    {
      "index": 35,
      "id": "L35",
      "text": "四美具，二难并。",
      "start_time": 114.127,
      "end_time": 115.81,
      "duration": 1.683
    },
    {
      "index": 36,
      "id": "L36",
      "text": "穷睇眄于中天，极娱游于暇日。",
      "start_time": 116.41,
      "end_time": 119.211,
      "duration": 2.801
    },
    {
      "index": 37,
      "id": "L37",
      "text": "天高地迥，觉宇宙之无穷；",
      "start_time": 119.811,
      "end_time": 122.621,
      "duration": 2.81
    },
    {
      "index": 38,
      "id": "L38",
      "text": "兴尽悲来，识盈虚之有数。",
      "start_time": 123.221,
      "end_time": 125.569,
      "duration": 2.347
    },
    {
      "index": 39,
      "id": "L39",
      "text": "望长安于日下，目吴会于云间。",
      "start_time": 126.169,
      "end_time": 129.337,
      "duration": 3.168
    },
    {
      "index": 40,
      "id": "L40",
      "text": "地势极而南溟深，天柱高而北辰远。",
      "start_time": 129.937,
      "end_time": 133.231,
      "duration": 3.294
    },
    {
      "index": 41,
      "id": "L41",
      "text": "关山难越，谁悲失路之人？",
      "start_time": 133.831,
      "end_time": 136.444,
      "duration": 2.614
    },
    {
      "index": 42,
      "id": "L42",
      "text": "萍水相逢，尽是他乡之客。",
      "start_time": 137.044,
      "end_time": 139.704,
      "duration": 2.66
    },
    {
      "index": 43,
      "id": "L43",
      "text": "怀帝阍而不见，奉宣室以何年？",
      "start_time": 140.304,
      "end_time": 143.341,
      "duration": 3.036
    },
    {
      "index": 44,
      "id": "L44",
      "text": "嗟乎！",
      "start_time": 143.941,
      "end_time": 144.709,
      "duration": 0.768
    },
    {
      "index": 45,
      "id": "L45",
      "text": "时运不齐，命途多舛。",
      "start_time": 145.309,
      "end_time": 147.442,
      "duration": 2.133
    },
    {
      "index": 46,
      "id": "L46",
      "text": "冯唐易老，李广难封。",
      "start_time": 148.042,
      "end_time": 150.368,
      "duration": 2.326
    },
    {
      "index": 47,
      "id": "L47",
      "text": "屈贾谊于长沙，非无圣主；",
      "start_time": 150.968,
      "end_time": 153.473,
      "duration": 2.505
    },
    {
      "index": 48,
      "id": "L48",
      "text": "窜梁鸿于海曲，岂乏明时？",
      "start_time": 154.073,
      "end_time": 156.698,
      "duration": 2.625
    },
    {
      "index": 49,
      "id": "L49",
      "text": "所赖君子见机，达人知命。",
      "start_time": 157.298,
      "end_time": 159.904,
      "duration": 2.606
    },
    {
      "index": 50,
      "id": "L50",
      "text": "老当益壮，宁移白首之心？",
      "start_time": 160.504,
      "end_time": 162.877,
      "duration": 2.373
    },
    {
      "index": 51,
      "id": "L51",
      "text": "穷且益坚，不坠青云之志。",
      "start_time": 163.477,
      "end_time": 166.067,
      "duration": 2.591
    },
    {
      "index": 52,
      "id": "L52",
      "text": "酌贪泉而觉爽，处涸辙以犹欢。",
      "start_time": 166.667,
      "end_time": 169.735,
      "duration": 3.067
    },
    {
      "index": 53,
      "id": "L53",
      "text": "北海虽赊，扶摇可接；",
      "start_time": 170.335,
      "end_time": 172.22,
      "duration": 1.886
    },
    {
      "index": 54,
      "id": "L54",
      "text": "东隅已逝，桑榆非晚。",
      "start_time": 172.82,
      "end_time": 174.911,
      "duration": 2.091
    },
    {
      "index": 55,
      "id": "L55",
      "text": "孟尝高洁，空余报国之情；",
      "start_time": 175.511,
      "end_time": 178.303,
      "duration": 2.792
    },
    {
      "index": 56,
      "id": "L56",
      "text": "阮籍猖狂，岂效穷途之哭！",
      "start_time": 178.903,
      "end_time": 181.785,
      "duration": 2.882
    },
    {
      "index": 57,
      "id": "L57",
      "text": "勃，三尺微命，一介书生。",
      "start_time": 182.385,
      "end_time": 185.197,
      "duration": 2.811
    },
    {
      "index": 58,
      "id": "L58",
      "text": "无路请缨，等终军之弱冠；",
      "start_time": 185.797,
      "end_time": 188.463,
      "duration": 2.666
    },
    {
      "index": 59,
      "id": "L59",
      "text": "有怀投笔，慕宗悫之长风。",
      "start_time": 189.063,
      "end_time": 191.858,
      "duration": 2.795
    },
    {
      "index": 60,
      "id": "L60",
      "text": "舍簪笏于百龄，奉晨昏于万里。",
      "start_time": 192.458,
      "end_time": 195.783,
      "duration": 3.325
    },
    {
      "index": 61,
      "id": "L61",
      "text": "非谢家之宝树，接孟氏之芳邻。",
      "start_time": 196.383,
      "end_time": 199.325,
      "duration": 2.942
    },
    {
      "index": 62,
      "id": "L62",
      "text": "他日趋庭，叨陪鲤对；",
      "start_time": 199.925,
      "end_time": 202.177,
      "duration": 2.252
    },
    {
      "index": 63,
      "id": "L63",
      "text": "今兹捧袂，喜托龙门。",
      "start_time": 202.777,
      "end_time": 204.89,
      "duration": 2.113
    },
    {
      "index": 64,
      "id": "L64",
      "text": "杨意不逢，抚凌云而自惜；",
      "start_time": 205.49,
      "end_time": 208.264,
      "duration": 2.774
    },
    {
      "index": 65,
      "id": "L65",
      "text": "钟期既遇，奏流水以何惭？",
      "start_time": 208.864,
      "end_time": 211.516,
      "duration": 2.652
    },
    {
      "index": 66,
      "id": "L66",
      "text": "呜呼！",
      "start_time": 212.116,
      "end_time": 213.035,
      "duration": 0.919
    },
    {
      "index": 67,
      "id": "L67",
      "text": "胜地不常，盛筵难再；",
      "start_time": 213.635,
      "end_time": 215.811,
      "duration": 2.176
    },
    {
      "index": 68,
      "id": "L68",
      "text": "兰亭已矣，梓泽丘墟。",
      "start_time": 216.411,
      "end_time": 218.457,
      "duration": 2.046
    },
    {
      "index": 69,
      "id": "L69",
      "text": "临别赠言，幸承恩于伟胄；",
      "start_time": 219.057,
      "end_time": 221.741,
      "duration": 2.685
    },
    {
      "index": 70,
      "id": "L70",
      "text": "登高作赋，是所望于群公。",
      "start_time": 222.341,
      "end_time": 224.843,
      "duration": 2.502
    },
    {
      "index": 71,
      "id": "L71",
      "text": "敢竭鄙怀，恭疏短引；",
      "start_time": 225.443,
      "end_time": 227.506,
      "duration": 2.062
    },
    {
      "index": 72,
      "id": "L72",
      "text": "一言均赋，四韵俱成。",
      "start_time": 228.106,
      "end_time": 230.086,
      "duration": 1.981
    },
    {
      "index": 73,
      "id": "L73",
      "text": "请洒潘江，各倾陆海云尔：",
      "start_time": 230.686,
      "end_time": 233.479,
      "duration": 2.792
    },
    {
      "index": 74,
      "id": "L74",
      "text": "滕王高阁临江渚，佩玉鸣鸾罢歌舞。",
      "start_time": 234.079,
      "end_time": 237.285,
      "duration": 3.207
    },
    {
      "index": 75,
      "id": "L75",
      "text": "画栋朝飞南浦云，珠帘暮卷西山雨。",
      "start_time": 237.885,
      "end_time": 241.173,
      "duration": 3.288
    },
    {
      "index": 76,
      "id": "L76",
      "text": "闲云潭影日悠悠，物换星移几度秋。",
      "start_time": 241.773,
      "end_time": 245.194,
      "duration": 3.42
    },
    {
      "index": 77,
      "id": "L77",
      "text": "阁中帝子今何在？",
      "start_time": 245.794,
      "end_time": 247.495,
      "duration": 1.701
    },
    {
      "index": 78,
      "id": "L78",
      "text": "槛外长江空自流。",
      "start_time": 248.095,
      "end_time": 249.937,
      "duration": 1.842
    }
  ]
}